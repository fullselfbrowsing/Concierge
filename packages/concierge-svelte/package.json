{
  "name": "@fullselfbrowsing/concierge-svelte",
  "version": "0.2.0",
  "private": false,
  "description": "Svelte bindings for @fullselfbrowsing/concierge",
  "keywords": [
    "ai",
    "agent",
    "svelte",
    "tool-calling",
    "browser-control",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullselfbrowsing/Concierge.git",
    "directory": "packages/concierge-svelte"
  },
  "homepage": "https://github.com/fullselfbrowsing/Concierge#readme",
  "bugs": {
    "url": "https://github.com/fullselfbrowsing/Concierge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client.svelte": {
      "types": "./dist/client.svelte.d.ts",
      "svelte": "./dist/client.svelte.js",
      "import": "./dist/client.svelte.js",
      "default": "./dist/client.svelte.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@fullselfbrowsing/concierge": "workspace:^",
    "svelte": "^5.0.0"
  },
  "scripts": {
    "build": "svelte-package",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --root ../.. --project svelte-lifecycle"
  },
  "devDependencies": {
    "@fullselfbrowsing/concierge": "workspace:*",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@testing-library/svelte": "5.4.2",
    "svelte": "5.56.9",
    "svelte-check": "4.7.5",
    "typescript": "6.0.3"
  }
}
