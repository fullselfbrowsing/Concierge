{
  "name": "concierge-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Typed, consent-gated actions that let an AI agent operate your web app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullselfbrowsing/concierge.git"
  },
  "homepage": "https://github.com/fullselfbrowsing/concierge#readme",
  "bugs": {
    "url": "https://github.com/fullselfbrowsing/concierge/issues"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "check:artifact": "pnpm --filter @fullselfbrowsing/concierge exec publint --strict && pnpm exec attw --pack packages/concierge --profile esm-only",
    "check:deps": "node scripts/pkg05-zero-runtime-deps.mjs packages/concierge/dist/index.js",
    "check:pack": "bash scripts/pack-install-check.sh",
    "check:node-floor": "bash scripts/node-floor-check.sh",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "fs-native-extensions": "1.5.0",
    "jsdom": "29.1.1",
    "publint": "0.3.22",
    "rolldown": "1.2.0",
    "svelte": "5.56.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
